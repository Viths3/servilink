# Base de datos MongoDB Atlas
MONGODB_URI=mongodb+srv://USUARIO:PASSWORD@cluster.mongodb.net/servilink?retryWrites=true&w=majority

# JWT — usar un string aleatorio largo (mínimo 32 caracteres)
JWT_SECRET=cambia_esto_por_un_secreto_muy_largo_y_aleatorio_123456
JWT_EXPIRES_IN=7d

# WhatsApp Business Cloud API (Meta)
# Obtener en: https://developers.facebook.com/apps/
# Plantillas necesarias (crear y aprobar en Meta Business Manager):
#   verificacion_aprobada, verificacion_rechazada, nueva_solicitud,
#   cita_confirmada, cita_rechazada, reagendamiento_propuesto,
#   respuesta_reagendamiento, upgrade_aprobado, upgrade_rechazado,
#   anuncio_editado, anuncio_suspendido, disputa_abierta, disputa_resuelta,
#   recordatorio_visita, recordatorio_solicitud_pendiente,
#   recordatorio_pago_pendiente
WHATSAPP_TOKEN=EAAxxxxxxxxxxxxxxxxxx
WHATSAPP_PHONE_NUMBER_ID=1234567890123456

# Servidor
PORT=5000
NODE_ENV=development

# URL pública del sitio en producción — restringe CORS a este origen.
PUBLIC_URL=https://tu-dominio.railway.app

# Verificación automática de proveedores: aprueba al instante cuando la
# cédula es válida y única, hay documentos y el teléfono es ecuatoriano.
# Poner en "false" para volver a la revisión manual del admin.
AUTO_VERIFY=true

# Pagos — comisión de la plataforma y ventana de retención (escrow)
PLATFORM_COMMISSION_PERCENT=10
PAYMENT_HOLD_HOURS=48

# PayPhone (pasarela de pago) — dejar PAYPHONE_MODE=demo mientras no haya
# credenciales reales; cambiar a "live" solo con token y storeId de producción.
# Obtener en: https://appdeveloper.payphone.app/
PAYPHONE_MODE=demo
PAYPHONE_TOKEN=
PAYPHONE_STORE_ID=

# scripts/seed-admin.js — crea/actualiza la cuenta de administrador.
# Nunca hardcodear estos valores en el script; solo se leen de aquí.
ADMIN_EMAIL=admin@tudominio.com
ADMIN_INITIAL_PASSWORD=cambia_esto_por_una_contrasena_larga_y_unica
